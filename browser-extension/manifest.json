{
  "manifest_version": 3,
  "name": "DevGeek · OpenAI-saldo",
  "version": "1.0.0",
  "description": "Läser det visade API-saldot i din valda OpenAI Billing-flik och skickar det lokalt till DevGeek.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "host_permissions": ["https://platform.openai.com/settings/organization/billing/*", "https://platform.openai.com/account/billing/*"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [{
    "matches": ["https://platform.openai.com/settings/organization/billing/*", "https://platform.openai.com/account/billing/*"],
    "js": ["reader.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "DevGeek · OpenAI-saldo" }
}
