                <Button Style="{StaticResource RowActionButton}" Content="&#xE70F;" Click="OpenEditor_Click" ToolTip="{Binding DataContext.EditorActionLabel, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Öppna i editor" />
