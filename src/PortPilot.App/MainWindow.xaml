        <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static core:ServiceTone.Good}"><Setter Property="Foreground" Value="#A3CDBC" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static core:ServiceTone.Warning}"><Setter Property="Foreground" Value="#E4CEA0" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static core:ServiceTone.Bad}"><Setter Property="Foreground" Value="{StaticResource RoseBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>
