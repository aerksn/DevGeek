            </Grid>
          </Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter TargetName="LaunchBody" Property="Opacity" Value="1" /><Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" /><Setter TargetName="StopGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="LaunchAction" Property="Style" Value="{StaticResource DenseStopButton}" /></DataTrigger>
        <DataTrigger Binding="{Binding HasFailed}" Value="True"><Setter TargetName="LaunchBody" Property="Opacity" Value="1" /><Setter TargetName="LaunchStatus" Property="Foreground" Value="{StaticResource RoseBrush}" /><Setter TargetName="ToneWash" Property="Fill" Value="#14F3C2D7" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
