          <TextBlock Text="{Binding ResourceSummary}" FontSize="9" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ServiceStatusTemplate}" Margin="8,0,0,0" />
        </Grid>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="ProjectMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Padding" Value="12,8" />
