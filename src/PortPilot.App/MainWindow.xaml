    <Style x:Key="AppearanceMenuItem" TargetType="MenuItem">
      <Setter Property="Padding" Value="8,7" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="MenuBody" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Checkmark" Text="✓" Visibility="Hidden" Foreground="{StaticResource AccentBrush}" /><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Checkmark" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBody" Property="Background" Value="#30BDAAF2" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="CompactUsageTemplate">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Grid.Column="1" Text="{Binding CompactValue}" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="low"><Setter Property="Foreground" Value="{StaticResource RoseBrush}" /></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="muted"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
      </Grid>
    </DataTemplate>
    <Style x:Key="DenseStopButton" TargetType="Button" BasedOn="{StaticResource StopButton}">
      <Setter Property="Width" Value="36" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" /><Setter Property="Background" Value="#28F3C2D7" /><Setter Property="BorderBrush" Value="#65F3C2D7" />
    </Style>
    <Style x:Key="UsageButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="UsageBody" Background="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UsageBody" Property="Background" Value="#10CFDDFB" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="UsageBody" Property="Background" Value="#20BDAAF2" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
