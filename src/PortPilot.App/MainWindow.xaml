    <DataTemplate x:Key="PortRowTemplate">
      <StackPanel VerticalAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceIconTemplate}" HorizontalAlignment="Left" />
