              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CompactDragArea" Background="Transparent" Height="26" shell:WindowChrome.IsHitTestVisibleInChrome="False" ToolTip="{Binding BalanceHint}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button x:Name="BalanceButton" Click="Balance_Click" Style="{StaticResource UsageButton}" Height="26" Padding="6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="OpenAI-saldo och koppling" ToolTip="{Binding BalanceHint}">
                  <StackPanel Orientation="Horizontal"><Path x:Name="OpenAiLogo" Data="{StaticResource OpenAiBlossom}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" /><TextBlock x:Name="CompactBalanceText" Text="{Binding BalanceLabel}" MaxWidth="156" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                </Button>
                <Border x:Name="CompactCaptionArea" Grid.Column="1" Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="False" ToolTip="Dra här för att flytta fönstret · Börja skriva för att filtrera" />
              </Grid>
            </Border>
            <Border x:Name="FilterBar" Visibility="Collapsed" Height="24" Margin="2,0,0,0" CornerRadius="7" Background="#28141224" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="7,0,5,0" />
                <Button x:Name="FilterClear" DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource RowActionButton}" FontSize="9" Click="FilterClear_Click" ToolTip="Rensa filtret (Esc)" AutomationProperties.Name="Rensa filtret" />
                <TextBox x:Name="FilterBox" TextChanged="Filter_Changed" PreviewKeyDown="FilterBox_PreviewKeyDown" FontSize="10.5" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}" VerticalContentAlignment="Center" ToolTip="Filtrerar på namn, port, PID, runtime, mapp eller snabbstart. Söker bland alla portar. Esc rensar, ↓ går till listan, Enter öppnar första träffen." AutomationProperties.Name="Filtrera portar">
                  <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" /></ControlTemplate></TextBox.Template>
                </TextBox>
              </DockPanel>
            </Border>
          </Grid>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="DropdownButton" Content="&#xE70D;" Click="Appearance_Click" Style="{StaticResource DenseIconButton}" Margin="0,0,2,0" ToolTip="Verktyg och inställningar" AutomationProperties.Name="Verktyg och inställningar" />
            <Button x:Name="MinimizeButton" Content="" Click="Minimize_Click" Style="{StaticResource DenseIconButton}" Margin="0,0,2,0" AutomationProperties.Name="Minimera" ToolTip="Minimera" />
            <Button x:Name="CloseButton" Content="" Click="Close_Click" Style="{StaticResource DenseIconButton}" AutomationProperties.Name="Stäng" ToolTip="Stäng" />
          </StackPanel>
        </Grid>
        <Grid x:Name="DensePorts" Grid.Row="1">
          <ScrollViewer x:Name="DenseScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="132" MaxHeight="308" Padding="0">
            <StackPanel>
              <ItemsControl x:Name="DensePortList" ItemsSource="{Binding Ports}" ItemTemplate="{StaticResource PortItemTemplate}" Margin="0" Padding="0" />
              <!-- Quick starts without an open port: idle, failed, or running before their server listens. -->
              <ItemsControl x:Name="LaunchList" ItemsSource="{Binding LaunchRows}" ItemTemplate="{StaticResource LaunchItemTemplate}" Margin="0" Padding="0" />
            </StackPanel>
          </ScrollViewer>
          <TextBlock x:Name="DenseEmptyPorts" Text="Läser aktiva portar…" FontSize="11" Foreground="{StaticResource MutedBrush}" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" Visibility="Collapsed" />
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,6" Visibility="Collapsed">
            <Image x:Name="EmptyMascot" Width="38" Height="38" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9" />
            <TextBlock Text="Inga tjänster igång" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock x:Name="EmptyHint" FontSize="9.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="270" Margin="0,3,0,0" />
            <Button x:Name="EmptyAdd" Content="+  Ny snabbstart" Click="Add_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Padding="10,4" FontSize="10" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
          </StackPanel>
          <!-- Confirmations float above the list and never take clicks from the rows underneath. -->
          <Border x:Name="Toast" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,8" Padding="10,6" CornerRadius="9" Background="#F22C293D" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#000000" /></Border.Effect>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ToastIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock x:Name="ToastText" FontSize="10.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxWidth="290" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="UsageSection" Grid.Row="2" Visibility="Collapsed" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
          <Grid>
          <Grid x:Name="CompactUsageBar" Height="27" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="CompactCodexUsage" Grid.Column="0" DataContext="{Binding CodexUsageRow}" Content="{Binding}" ContentTemplate="{StaticResource CompactUsageTemplate}" Click="Usage_Click" Style="{StaticResource UsageButton}" Padding="8,0" ToolTip="{Binding Hint}" AutomationProperties.Name="Codex återstående kvot" />
            <TextBlock x:Name="UsageDivider" Grid.Column="1" Text="|" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Name="CompactClaudeUsage" Grid.Column="2" DataContext="{Binding ClaudeUsageRow}" Content="{Binding}" ContentTemplate="{StaticResource CompactUsageTemplate}" Click="Usage_Click" Style="{StaticResource UsageButton}" Padding="8,0" ToolTip="{Binding Hint}" AutomationProperties.Name="Claude Code återstående kvot" />
          </Grid>

          </Grid>
        </Border>
        <Grid x:Name="LaunchSection" Visibility="Collapsed" Grid.Row="3" Margin="30,14,30,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="SNABBSTARTER" Style="{StaticResource SectionLabel}" />
          <Button Content="+  Lägg till" Click="Add_Click" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" />
          <ScrollViewer Grid.Row="1" MaxHeight="116" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-5,9,-5,0" Padding="5">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding QuickStarts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="100" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Command}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Directory}" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}" />
                            <TextBlock Text="{Binding Status}" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecoveryError}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="{Binding ActionLabel}" IsEnabled="{Binding CanAct}" Click="Launch_Click" Style="{StaticResource PrimaryButton}" Padding="12,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                              <Button Content="Logg" Click="Log_Click" Style="{StaticResource QuietButton}" Padding="6,4" FontSize="9" />
                              <Button Content="Redigera" IsEnabled="{Binding CanEdit}" Click="Edit_Click" Style="{StaticResource QuietButton}" Padding="4,4" FontSize="9" />
                              <Button Content="&#xE777;" IsEnabled="{Binding CanRestart}" Click="RestartLaunch_Click" Style="{StaticResource QuietButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Padding="5,4" ToolTip="Starta om snabbstarten" AutomationProperties.Name="Starta om snabbstarten" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="EmptyLaunches" Text="Lägg till en arbetsmapp och ett kommando." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,6,0,12" />
            </StackPanel>
          </ScrollViewer>
        </Grid>

      </Grid>
    </Border>
  </Border>
</Window>
