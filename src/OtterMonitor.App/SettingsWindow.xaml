<Window x:Class="OtterMonitor.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:OtterMonitor.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{local:Loc 'Otter Monitor · Inställningar'}" Width="430" MinWidth="380" Height="590" MaxHeight="720" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <Style x:Key="EyeToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="36" /><Setter Property="Height" Value="32" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="EyeSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
          <Grid Width="19" Height="19" IsHitTestVisible="False">
            <Path Data="M1,9.5 C5,2 14,2 18,9.5 C14,17 5,17 1,9.5 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" />
            <Ellipse Width="5" Height="5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" />
            <Path x:Name="Slash" Data="M2,2 L17,17" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Slash" Property="Visibility" Value="Collapsed" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EyeSurface" Property="Background" Value="#20CFDDFB" /></Trigger>


        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChoiceButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Padding" Value="11,8" /><Setter Property="Margin" Value="0,0,6,6" /><Setter Property="FontSize" Value="11" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="ChoiceSurface" CornerRadius="8" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#32BDAAF2" /><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#20CFDDFB" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChoiceSurface" Property="Opacity" Value="0.35" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="38" /><Setter Property="Height" Value="30" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="SwitchSurface" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"><Border x:Name="Track" Width="30" Height="16" CornerRadius="8" Background="#35C9C7DA"><Ellipse x:Name="Thumb" Width="10" Height="10" Fill="{StaticResource TextBrush}" HorizontalAlignment="Left" Margin="3,0" /></Border></Border>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#A0BDAAF2" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchSurface" Property="Background" Value="#14CFDDFB" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="CornerRadius" Value="12" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter Property="Background" Value="#0CD7D9FF" /><Setter Property="Padding" Value="14" /></Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="76" ResizeBorderThickness="0" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border x:Name="SettingsSurface" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceBrush}">
    <Grid Margin="22,16,22,20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="OTTER MONITOR" FontSize="9" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{local:Loc 'Inställningar'}" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
        <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Style="{StaticResource QuietButton}" Width="28" Height="28" Padding="0" VerticalAlignment="Top" Click="Close_Click" IsCancel="True" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{local:Loc 'Stäng inställningar'}" AutomationProperties.Name="{local:Loc 'Stäng inställningar'}" />
      </Grid>
      <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
        <RadioButton x:Name="VisibilityTab" Content="{local:Loc 'Synlighet'}" GroupName="section" Tag="visibility" Style="{StaticResource ChoiceButton}" IsChecked="True" Checked="Section_Changed" />
        <RadioButton x:Name="GeneralTab" Content="{local:Loc 'Allmänt'}" GroupName="section" Tag="general" Style="{StaticResource ChoiceButton}" Checked="Section_Changed" />
        <RadioButton x:Name="AppearanceTab" Content="{local:Loc 'Utseende'}" GroupName="section" Tag="appearance" Style="{StaticResource ChoiceButton}" Margin="0,0,0,6" Checked="Section_Changed" />
      </UniformGrid>
      <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
        <Grid>
          <StackPanel x:Name="VisibilityPanel">
            <TextBlock Text="{local:Loc 'Ditt huvudfönster'}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Klicka på ögat för att visa eller dölja en del.'}" Style="{StaticResource Muted}" Margin="0,5,0,14" />
            <TextBlock Text="{local:Loc 'API-saldon'}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,8" />
            <Border Style="{StaticResource SettingsCard}" Padding="14,4"><StackPanel>
              <Grid Margin="0,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="OpenAI" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Återstående API-saldo'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel><ToggleButton x:Name="OpenAiToggle" Grid.Column="1" Style="{StaticResource EyeToggle}" Tag="openai" Checked="Visibility_Changed" Unchecked="Visibility_Changed" AutomationProperties.Name="{local:Loc 'Visa eller dölj OpenAI-saldo'}" ToolTip="{local:Loc 'Visa eller dölj OpenAI-saldot'}" /></Grid>
              <Border Height="1" Background="{StaticResource DividerBrush}" />
              <Grid Margin="0,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="JEV" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Återstående saldo hos TypeSafe'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel><ToggleButton x:Name="JevToggle" Grid.Column="1" Style="{StaticResource EyeToggle}" Tag="jev" Checked="Visibility_Changed" Unchecked="Visibility_Changed" AutomationProperties.Name="{local:Loc 'Visa eller dölj JEV-saldo'}" ToolTip="{local:Loc 'Visa eller dölj JEV-saldot'}" /></Grid>
              <Border Height="1" Background="{StaticResource DividerBrush}" />
              <Grid Margin="0,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Anthropic API" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Återstående API-saldo'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel><ToggleButton x:Name="AnthropicToggle" Grid.Column="1" Style="{StaticResource EyeToggle}" Tag="anthropic" Checked="Visibility_Changed" Unchecked="Visibility_Changed" AutomationProperties.Name="{local:Loc 'Visa eller dölj Anthropic API-saldo'}" ToolTip="{local:Loc 'Visa eller dölj Anthropic API-saldot'}" /></Grid>
            </StackPanel></Border>
            <TextBlock Text="{local:Loc 'Kodassistenter'}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,8" />
            <Border Style="{StaticResource SettingsCard}" Padding="14,4"><StackPanel>
              <Grid Margin="0,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Codex" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Kontots återstående kvot'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel><ToggleButton x:Name="CodexToggle" Grid.Column="1" Style="{StaticResource EyeToggle}" Tag="codex" Checked="Visibility_Changed" Unchecked="Visibility_Changed" AutomationProperties.Name="{local:Loc 'Visa eller dölj Codex-kvot'}" ToolTip="{local:Loc 'Visa eller dölj Codex-kvoten'}" /></Grid>
              <Border Height="1" Background="{StaticResource DividerBrush}" />
              <Grid Margin="0,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Claude Code" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Kontots återstående kvot'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel><ToggleButton x:Name="ClaudeToggle" Grid.Column="1" Style="{StaticResource EyeToggle}" Tag="claude" Checked="Visibility_Changed" Unchecked="Visibility_Changed" AutomationProperties.Name="{local:Loc 'Visa eller dölj Claude Code-kvot'}" ToolTip="{local:Loc 'Visa eller dölj Claude Code-kvoten'}" /></Grid>
            </StackPanel></Border>
            <TextBlock Text="{local:Loc 'Dolda delar kan visas igen här. Dina kontokopplingar och inloggningar behålls.'}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="1,12,1,0" LineHeight="16" />
          </StackPanel>
          <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">
            <TextBlock Text="{local:Loc 'Språk'}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{local:Loc 'Välj språk för appens gränssnitt.'}" Style="{StaticResource Muted}" Margin="0,5,0,10" />
            <WrapPanel Margin="0,0,0,18">
              <RadioButton x:Name="EnglishLanguage" Content="English" Tag="en" GroupName="language" Style="{StaticResource ChoiceButton}" Checked="Language_Changed" />
              <RadioButton x:Name="SwedishLanguage" Content="Svenska" Tag="sv" GroupName="language" Style="{StaticResource ChoiceButton}" Checked="Language_Changed" />
            </WrapPanel>
            <TextBlock Text="Editor" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Välj var dina projekt ska öppnas.'}" Style="{StaticResource Muted}" Margin="0,5,0,14" />
            <WrapPanel x:Name="EditorChoices" Margin="0,0,0,16" />
            <TextBlock Text="{local:Loc 'Webbadress'}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{local:Loc 'Adress när du öppnar eller kopierar en lokal webblänk.'}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10" />
            <StackPanel x:Name="BrowserAddressChoices" Margin="0,0,0,16" HorizontalAlignment="Left" />
            <TextBlock Text="{local:Loc 'Om en tjänst inte svarar via ditt val används en annan verifierad adress.'}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{local:Loc 'Notiser'}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Vid tjänstefel och ändrade kvoter.'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><ToggleButton x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource SettingSwitch}" Tag="notifications" Checked="Option_Changed" Unchecked="Option_Changed" AutomationProperties.Name="{local:Loc 'Notiser'}" /></Grid>
              <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{local:Loc 'Stäng till systemfältet'}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Krysset döljer appen, som fortsätter köras.'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><ToggleButton x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource SettingSwitch}" Tag="tray" Checked="Option_Changed" Unchecked="Option_Changed" AutomationProperties.Name="{local:Loc 'Stäng till systemfältet'}" /></Grid>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
            <TextBlock Text="{local:Loc 'Bakgrund'}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Välj material för appens fönster.'}" Style="{StaticResource Muted}" Margin="0,5,0,14" />
            <WrapPanel x:Name="BackgroundChoices" />
            <TextBlock x:Name="MaterialHint" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="1,4,0,16" MinHeight="28" />
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Loc 'Visa fönsterram'}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'En tunn linje runt fönstret.'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel><ToggleButton x:Name="BorderToggle" Grid.Column="1" Style="{StaticResource SettingSwitch}" Tag="border" Checked="Option_Changed" Unchecked="Option_Changed" AutomationProperties.Name="{local:Loc 'Visa fönsterram'}" /></Grid>
              <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{local:Loc 'Färg och transparens'}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{local:Loc 'Anpassa färgtonen och glaset.'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="1" Content="{local:Loc 'Anpassa…'}" Style="{StaticResource QuietButton}" Padding="10,7" Click="Appearance_Click" /></Grid>
            </StackPanel></Border>
            <Button x:Name="ResetAppearance" Content="{local:Loc 'Återställ utseende'}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetAppearance_Click" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <TextBlock x:Name="SavedHint" Grid.Row="3" Text="Dina val sparas direkt." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap" />
    </Grid>
  </Border>
</Window>
