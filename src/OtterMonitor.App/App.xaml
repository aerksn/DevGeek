<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="OtterMonitor.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:OtterMonitor.Core;assembly=OtterMonitor.Core">
  <Application.Resources>
    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#343044" Offset="0" />
      <GradientStop Color="#272839" Offset="0.55" />
      <GradientStop Color="#283A44" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="#16D7D9FF" />
    <SolidColorBrush x:Key="LineBrush" Color="#30DFDFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#18DFDFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F2FC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#C9C7DA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#CFDDFB" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#BDAAF2" />
    <SolidColorBrush x:Key="RoseBrush" Color="#F3C2D7" />
    <Style x:Key="AppearanceSlider" TargetType="Slider">
      <Setter Property="Height" Value="20" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid VerticalAlignment="Center"><Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{StaticResource AccentStrongBrush}" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{StaticResource LineBrush}" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track></Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0.7,1">
      <GradientStop Color="#40372B53" Offset="0" />
      <GradientStop Color="#20243445" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#20E3DDFF" Offset="0" />
      <GradientStop Color="#0AC7D8FA" Offset="1" />
    </LinearGradientBrush>
    <Style TargetType="Window">
      <Setter Property="Icon" Value="/OtterMonitor;component/otter-monitor.ico" />
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#F02C293D" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- Translucent controls keep the desktop material continuous, with an explicit focus ring. -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="ControlBody">
              <Border x:Name="Rim" CornerRadius="10" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                <Border Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rim" Property="BorderBrush" Value="#A0CFDDFB" />
                <Setter TargetName="Rim" Property="Background" Value="#35CFDDFB" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Rim" Property="Background" Value="#50BDAAF2" />
                <Setter TargetName="ControlBody" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform Y="1" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ControlBody" Property="Opacity" Value="0.4" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Rim" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Rim" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="#32AB9CDD" />
      <Setter Property="BorderBrush" Value="#8CBDAAF2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource RoseBrush}" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="#08FFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Body" Property="Background" Value="#20D9D0FF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#28141224" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="#887F6BAA" />
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border>
              <Border x:Name="Rim" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer x:Name="PART_ContentHost" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Rim" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Focus" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1" Padding="3">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="Track" Width="28" Height="16" CornerRadius="8" Background="#30D7D9F4" BorderBrush="#40D7D9F4" BorderThickness="1" Margin="0,0,8,0">
                  <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0" />
                </Border>
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#A695D5" />
                <Setter TargetName="Track" Property="BorderBrush" Value="#BDAAF2" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Focus" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#70CDC4EA" CornerRadius="3" Width="4" HorizontalAlignment="Right" Margin="0,4,2,4" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Geometry x:Key="NodeGlyph">M9,1 L16,5 L16,13 L9,17 L2,13 L2,5 Z M6,12 L6,6 L12,12 L12,6</Geometry>
    <Geometry x:Key="DockerGlyph">M1,9 L14,9 C15,9 16,7 17,7 L17,10 C15,11 15,15 9,15 C4,15 2,13 1,9 Z M3,5 L6,5 L6,8 L3,8 Z M7,5 L10,5 L10,8 L7,8 Z M11,5 L14,5 L14,8 L11,8 Z M7,1 L10,1 L10,4 L7,4 Z</Geometry>
    <Geometry x:Key="BunGlyph">M9,1 C9,4 16,5 16,11 C16,15 13,17 9,17 C5,17 2,15 2,11 C2,6 6,4 9,1 Z M6,10 L6,11 M12,10 L12,11 M7,13 Q9,15 11,13</Geometry>
    <Geometry x:Key="CodeGlyph">M6,3 L2,9 L6,15 M12,3 L16,9 L12,15 M10,3 L8,15</Geometry>
    <Geometry x:Key="PythonGlyph">M3,8 L3,4 Q3,2 6,2 L12,2 Q15,2 15,5 L15,9 L8,9 L8,13 L2,13 L2,8 Z M15,10 L15,14 Q15,16 12,16 L6,16 Q3,16 3,13 M6,5 L7,5 M11,13 L12,13</Geometry>
    <Geometry x:Key="TcpGlyph">M5,2 L13,2 L13,7 L5,7 Z M9,7 L9,11 M2,11 L16,11 M3,11 L3,14 M15,11 L15,14 M1,14 L5,14 L5,17 L1,17 Z M13,14 L17,14 L17,17 L13,17 Z</Geometry>
    <Style x:Key="ServiceGlyph" TargetType="Path">
      <Setter Property="Data" Value="{StaticResource TcpGlyph}" /><Setter Property="Stroke" Value="{StaticResource MutedBrush}" /><Setter Property="StrokeThickness" Value="1.35" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ServiceIcon}" Value="node"><Setter Property="Data" Value="{StaticResource NodeGlyph}" /><Setter Property="Stroke" Value="#A3CDBC" /></DataTrigger>
        <DataTrigger Binding="{Binding ServiceIcon}" Value="docker"><Setter Property="Data" Value="{StaticResource DockerGlyph}" /><Setter Property="Stroke" Value="{StaticResource AccentBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding ServiceIcon}" Value="bun"><Setter Property="Data" Value="{StaticResource BunGlyph}" /><Setter Property="Stroke" Value="#E4CEA0" /></DataTrigger>
        <DataTrigger Binding="{Binding ServiceIcon}" Value="dotnet"><Setter Property="Data" Value="{StaticResource CodeGlyph}" /><Setter Property="Stroke" Value="#C6B7F0" /></DataTrigger>
        <DataTrigger Binding="{Binding ServiceIcon}" Value="python"><Setter Property="Data" Value="{StaticResource PythonGlyph}" /><Setter Property="Stroke" Value="#E4CEA0" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="ServiceIconTemplate"><Viewbox Width="16" Height="16" ToolTip="{Binding ServiceLabel}" AutomationProperties.Name="{Binding ServiceLabel}"><Canvas Width="18" Height="18"><Path Style="{StaticResource ServiceGlyph}" /></Canvas></Viewbox></DataTemplate>
    <!-- Project picker in "Ny snabbstart". -->
    <Style x:Key="PickerList" TargetType="ListBox">
      <Setter Property="Background" Value="#18141224" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ScrollViewer Focusable="False"><ItemsPresenter /></ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PickerItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Padding" Value="8,5" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Body" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#14CFDDFB" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="#33BDAAF2" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="Background" Value="#26BDAAF2" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChipList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Margin" Value="0,0,6,6" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Body" Background="#10D7D9FF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#20D9D0FF" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="#3AAB9CDD" /><Setter TargetName="Body" Property="BorderBrush" Value="#8CBDAAF2" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="ProjectCandidateTemplate">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding Candidate}" ContentTemplate="{StaticResource ServiceIconTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Candidate.Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Candidate.Location}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Candidate.Directory}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,2,0" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ProjectCommandTemplate"><TextBlock Text="{Binding Command}" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></DataTemplate>
    <!-- Log window: a darker reading surface with colored lines. -->
    <Style x:Key="LogList" TargetType="ListBox">
      <Setter Property="Background" Value="#38100E1C" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="SelectionMode" Value="Extended" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" /><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" /><Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="4,8,4,8">
          <ScrollViewer x:Name="LogScroll" Focusable="False" Padding="0,0,4,0"><ItemsPresenter /></ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LogItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Body" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#0CCFDDFB" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="#33BDAAF2" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="LogLineTemplate">
      <TextBlock x:Name="Line" FontFamily="Cascadia Mono,Consolas" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="#E6E2F2">
        <Run Text="{Binding Prefix, Mode=OneWay}" Foreground="#9C98B4" /><Run Text="{Binding Body, Mode=OneWay}" />
      </TextBlock>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogLevel.Error}"><Setter TargetName="Line" Property="Foreground" Value="{StaticResource RoseBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogLevel.Warning}"><Setter TargetName="Line" Property="Foreground" Value="#E4CEA0" /></DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogLevel.Success}"><Setter TargetName="Line" Property="Foreground" Value="#A3CDBC" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Application.Resources>
</Application>
