    <DataTemplate x:Key="CompactUsageTemplate">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Grid.Column="1" Text="{Binding CompactValue}" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="low"><Setter Property="Foreground" Value="{StaticResource RoseBrush}" /></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="muted"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
      </Grid>
    </DataTemplate>
    <Style x:Key="DenseStopButton" TargetType="Button" BasedOn="{StaticResource StopButton}">
      <Setter Property="Width" Value="28" /><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="#DEC4D3" /><Setter Property="Background" Value="#14F3C2D7" /><Setter Property="BorderBrush" Value="#30F3C2D7" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="StopSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
