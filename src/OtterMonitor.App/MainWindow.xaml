      <Setter Property="Width" Value="22" /><Setter Property="Height" Value="16" /><Setter Property="Margin" Value="0,0,2,0" /><Setter Property="IsTabStop" Value="False" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" /><Setter Property="FontSize" Value="11" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" Background="Transparent" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#26CFDDFB" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MenuSeparator" TargetType="Separator">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="8,4" Background="{StaticResource DividerBrush}" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ProjectMenuItem" TargetType="MenuItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Padding" Value="12,8" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="Body" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Body" Property="Background" Value="#30BDAAF2" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="RowMenuTemplate" TargetType="ContextMenu"><Border Background="#FA292738" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="4"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" /></Border></ControlTemplate>
    <!-- Implicit item styles instead of ItemContainerStyle, so separators keep their own style. -->
    <ContextMenu x:Key="ProjectMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Template="{StaticResource RowMenuTemplate}" FontSize="11" Foreground="{StaticResource TextBrush}" Opened="RowMenu_Opened">
      <ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource ProjectMenuItem}" /></ContextMenu.Resources>
      <MenuItem Header="{local:Loc 'Öppna i webbläsaren'}" Tag="browse" IsEnabled="{Binding CanBrowse}" Click="Browse_Click" />
      <MenuItem Header="{Binding Address}" HeaderStringFormat="Kopiera {0}" Tag="copy" Click="CopyAddress_Click" />
      <MenuItem Header="{Binding CopyIdLabel}" Tag="copy-id" Click="CopyId_Click" />
      <Separator Style="{StaticResource MenuSeparator}" />
      <MenuItem Header="{local:Loc 'Öppna terminal i projektmappen'}" Tag="terminal" Click="OpenTerminal_Click" />
      <MenuItem Header="{local:Loc 'Öppna i editor'}" Tag="editor" Click="OpenEditor_Click" />
      <Separator Style="{StaticResource MenuSeparator}" />
      <MenuItem Header="{local:Loc 'Visa logg'}" Tag="log" IsEnabled="{Binding CanShowLog}" Click="RowLog_Click" />
      <MenuItem Header="{local:Loc 'Starta om'}" Tag="restart" IsEnabled="{Binding CanRestart}" Click="RowRestart_Click" />
      <MenuItem Header="{local:Loc 'Stoppa…'}" Tag="stop" IsEnabled="{Binding CanStop}" Click="StopPort_Click" />
    </ContextMenu>
    <ContextMenu x:Key="LaunchMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Template="{StaticResource RowMenuTemplate}" FontSize="11" Foreground="{StaticResource TextBrush}" Opened="RowMenu_Opened">
      <ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource ProjectMenuItem}" /></ContextMenu.Resources>
      <MenuItem Header="{Binding ActionLabel}" Tag="toggle" IsEnabled="{Binding CanAct}" Click="Launch_Click" />
      <MenuItem Header="{local:Loc 'Starta om'}" Tag="restart" IsEnabled="{Binding CanRestart}" Click="RestartLaunch_Click" />
      <MenuItem Header="{local:Loc 'Visa logg'}" Tag="log" Click="Log_Click" />
      <MenuItem Header="{local:Loc 'Redigera…'}" Tag="edit" IsEnabled="{Binding CanEdit}" Click="Edit_Click" />
      <Separator Style="{StaticResource MenuSeparator}" />
      <MenuItem Header="{local:Loc 'Öppna terminal i arbetsmappen'}" Tag="terminal" Click="LaunchTerminal_Click" />
      <MenuItem Header="{local:Loc 'Öppna i editor'}" Tag="editor" Click="LaunchEditor_Click" />
    </ContextMenu>
    <Style x:Key="PortRow" TargetType="Border">
      <Setter Property="MinHeight" Value="52" /><Setter Property="Background" Value="Transparent" /><Setter Property="Focusable" Value="True" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="ToolTip" Value="{Binding Hint}" /><Setter Property="ContextMenu" Value="{StaticResource ProjectMenu}" />
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#10CFDDFB" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="LaunchRow" TargetType="Border" BasedOn="{StaticResource PortRow}">
      <Setter Property="ToolTip" Value="{Binding RowHint}" /><Setter Property="ContextMenu" Value="{StaticResource LaunchMenu}" />
    </Style>
    <Style x:Key="DenseLaunchButton" TargetType="Button" BasedOn="{StaticResource DenseStopButton}">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="#14CFDDFB" /><Setter Property="BorderBrush" Value="#30CFDDFB" />
    </Style>
    <DataTemplate x:Key="PortItemTemplate">
      <Border x:Name="Row" Style="{StaticResource PortRow}" Padding="10,9,4,7" PreviewMouseLeftButtonDown="PortRow_MouseDown" KeyDown="PortRow_KeyDown">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
          <!-- A faint tint marks a failing service; rows never reorder under the cursor. -->
          <Rectangle x:Name="ToneWash" Grid.ColumnSpan="2" Margin="-10,-9,-4,-7" Fill="Transparent" IsHitTestVisible="False" />
          <StackPanel VerticalAlignment="Center">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceIconTemplate}" HorizontalAlignment="Left" />
              <DockPanel Grid.Column="1">
                <TextBlock x:Name="LaunchMark" DockPanel.Dock="Right" Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource AccentStrongBrush}" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="{Binding IsLaunch, Converter={StaticResource Visible}}" ToolTip="{Binding LaunchHint}" AutomationProperties.Name="{Binding LaunchHint}" />
                <TextBlock x:Name="RowName" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="RowPorts" Grid.Column="2" Text="{Binding InlinePorts}" FontFamily="Cascadia Mono,Consolas" FontSize="10.5" Foreground="{StaticResource AccentBrush}" MaxWidth="166" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="{Binding PortSummary}" />
            </Grid>
            <Grid Margin="22,2,0,0" Height="16">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="RowResources" Text="{Binding ResourceSummary}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <StackPanel x:Name="RowActions" Orientation="Horizontal" Visibility="Collapsed" Margin="-4,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource RowActionButton}" Content="&#xE774;" Click="Browse_Click" Visibility="{Binding CanBrowse, Converter={StaticResource Visible}}" ToolTip="{local:Loc 'Öppna i webbläsaren'}" AutomationProperties.Name="{local:Loc 'Öppna i webbläsaren'}" />
                <Button Style="{StaticResource RowActionButton}" Content="&#xE756;" Click="OpenTerminal_Click" ToolTip="{local:Loc 'Öppna terminal i projektmappen'}" AutomationProperties.Name="{local:Loc 'Öppna terminal i projektmappen'}" />
                <Button Style="{StaticResource RowActionButton}" Content="&#xE70F;" Click="OpenEditor_Click" ToolTip="{Binding DataContext.EditorActionLabel, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{local:Loc 'Öppna i editor'}" />
                <Button Style="{StaticResource RowActionButton}" Content="&#xE8C8;" Click="CopyAddress_Click" ToolTip="{Binding Address}" ToolTipService.InitialShowDelay="200" AutomationProperties.Name="{local:Loc 'Kopiera adress'}" />
                <Button Style="{StaticResource RowActionButton}" Content="&#xE8A5;" Click="RowLog_Click" Visibility="{Binding CanShowLog, Converter={StaticResource Visible}}" ToolTip="{local:Loc 'Visa logg'}" AutomationProperties.Name="{local:Loc 'Visa logg'}" />
                <Button Style="{StaticResource RowActionButton}" Content="&#xE72C;" Click="RowRestart_Click" Visibility="{Binding CanRestart, Converter={StaticResource Visible}}" ToolTip="{local:Loc 'Starta om'}" AutomationProperties.Name="{local:Loc 'Starta om'}" />
              </StackPanel>
              <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ServiceStatusTemplate}" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
          <Button x:Name="DenseStop" Grid.Column="1" IsEnabled="{Binding CanStop}" Click="StopPort_Click" Style="{StaticResource DenseStopButton}" Margin="6,0,4,0" ToolTip="{local:Loc 'Stoppa hela processen eller containern, inklusive alla dess portar'}" AutomationProperties.Name="{Binding Name, StringFormat=Stoppa {0}}">
            <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="RowActions" Property="Visibility" Value="Visible" /><Setter TargetName="RowResources" Property="Visibility" Value="Hidden" /></Trigger>
        <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowActions" Property="Visibility" Value="Visible" /><Setter TargetName="RowResources" Property="Visibility" Value="Hidden" /></Trigger>
        <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static core:ServiceTone.Bad}"><Setter TargetName="ToneWash" Property="Fill" Value="#14F3C2D7" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="LaunchItemTemplate">
      <Border x:Name="Row" Style="{StaticResource LaunchRow}" Padding="10,9,4,7" PreviewMouseLeftButtonDown="LaunchRow_MouseDown">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
          <Rectangle x:Name="ToneWash" Grid.ColumnSpan="2" Margin="-10,-9,-4,-7" Fill="Transparent" IsHitTestVisible="False" />
          <StackPanel x:Name="LaunchBody" VerticalAlignment="Center" Opacity="0.62">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource AccentStrongBrush}" VerticalAlignment="Center" ToolTip="{local:Loc 'Snabbstart'}" />
              <TextBlock x:Name="LaunchName" Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Command}" FontFamily="Cascadia Mono,Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
            <TextBlock x:Name="LaunchStatus" Margin="22,2,0,0" Height="16" Text="{Binding RowStatus}" FontSize="9" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="LaunchAction" Grid.Column="1" IsEnabled="{Binding CanAct}" Click="Launch_Click" Style="{StaticResource DenseLaunchButton}" Margin="6,0,4,0" ToolTip="{Binding ActionLabel}" AutomationProperties.Name="{Binding Name, StringFormat=Starta eller stoppa {0}}">
            <Grid>
              <Path x:Name="PlayGlyph" Data="M0,0 L8,5 L0,10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1,0,0,0" />
              <Rectangle x:Name="StopGlyph" Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Visibility="Collapsed" />
            </Grid>
          </Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter TargetName="LaunchBody" Property="Opacity" Value="1" /><Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" /><Setter TargetName="StopGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="LaunchAction" Property="Style" Value="{StaticResource DenseStopButton}" /></DataTrigger>
        <DataTrigger Binding="{Binding HasFailed}" Value="True"><Setter TargetName="LaunchBody" Property="Opacity" Value="1" /><Setter TargetName="LaunchStatus" Property="Foreground" Value="{StaticResource RoseBrush}" /><Setter TargetName="ToneWash" Property="Fill" Value="#14F3C2D7" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="DenseIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="FontSize" Value="11" />
    </Style>
