        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StopSurface" Property="Background" Value="#2CF3C2D7" /><Setter Property="Foreground" Value="{StaticResource RoseBrush}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="UsageButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="UsageBody" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
